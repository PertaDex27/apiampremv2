      }
    ]
  }
}</pre>
        </div>

        <!-- ====== END SAVEFROM SECTION ====== -->

        <div class="api-item">
          <div class="api-item-name">
            <span class="api-method get">GET</span> Debug Client &amp; Region
          </div>
          <div class="api-url">/?debug=1&video={VIDEO_ID}</div>
          <div class="api-desc">
            Handy for checking server health: returns <b>summary</b>, <b>env</b> (visitor data / po-token status,
            region list, Cloudflare info) and <b>results</b> — the outcome of every
            client × region combination (ANDROID, IOS, WEB, etc.) together with its OK / error status.
          </div>
        </div>

        <div class="api-item">
          <div class="api-item-name">
            <span class="api-method get">GET</span> Code used by this site
          </div>
          <div class="api-desc">
            The <b>Downloader → YouTube</b> tab uses <code>?url=</code> to read the real resolution list of the video,
            then <code>?dl=</code> (the ready-made links inside <b>data.videos[].url</b> / <b>data.audios[].url</b>) to download.
            No static list like 2160p / 1440p is forced: only formats that actually exist for that video are shown,
            each with a <b>with audio</b> / <b>no audio</b> badge.<br>
            If YouTube is completely down, the Worker automatically falls back to SaveFrom — no frontend changes required.
          </div>
          <button class="api-code-toggle" data-target="code-yt-web">
            <i class="fa-solid fa-chevron-right"></i> Example
          </button>
          <pre class="api-code" id="code-yt-web">const YT_DL_API = 'https://api-ytdlv1.xyncteamofficial.workers.dev';

async function ytRequestMeta(input) {
  const params = new URLSearchParams({ url: input });
  if (/^\/shorts\//.test(new URL(input.includes('://') ? input : `https://${input}`).pathname)) {
    params.set('type', 'shorts');
  }
  const res  = await fetch(`${YT_DL_API}?${params}`, {
    headers: { 'Accept': 'application/json' },
    cache: 'no-store'
  });
  const json = await res.json().catch(() => ({}));
  if (!res.ok || !json.success || !json.data) {
    throw new Error(json.error || `HTTP ${res.status}`);
  }
  return json;
}

function ytVideoOptions(data) {
  const byHeight = new Map();
  const score = v => (v.hasAudio ? 100 : 0) + (v.extension === 'mp4' ? 20 : 0)
  + Math.min(10, (Number(v.bitrate) || 0) / 1e6);
  (data.videos || []).forEach(v => {
    const h = Number(v.height);
    if (!h) return;
    const cur = byHeight.get(h);
    if (!cur || score(v) > score(cur)) byHeight.set(h, v);
  });
  return [...byHeight.entries()].sort((a, b) => b[0] - a[0]).map(([h, v]) => ({
    label: h + 'p' + (Number(v.fps) >= 50 ? '60' : ''),
    ext: v.extension, itag: v.itag, size: v.fileSize,
    hasAudio: !!v.hasAudio,
    url: v.url
  }));
}

async function ytDownloadFile(option, btn) {
  const res   = await fetch(option.url, { redirect: 'follow' });
  const total = Number(res.headers.get('content-length')) || 0;
  const name  = (res.headers.get('content-disposition') || '')
  .match(/filename\*?=(?:UTF-8'')?["']?([^";']+)/i);

  const reader = res.body.getReader();
  const chunks = [];
  let got = 0;
  while (true) {
    const { done, value } = await reader.read();
    if (done) break;
    chunks.push(value);
    got += value.length;
    btn.textContent = Math.round((got / total) * 100) + '%';
  }

  const a = document.createElement('a');
  a.href = URL.createObjectURL(new Blob(chunks));
  a.download = name ? decodeURIComponent(name[1]) : `video-${option.label}.${option.ext}`;
  a.click();
}

function ytProxyUrl(rawUrl) {
  return `${YT_DL_API}?proxy=${encodeURIComponent(rawUrl)}`;
}</pre>
        </div>

        <div class="api-item">
          <div class="api-item-name">
            <span class="api-method get">GET</span> Error Format
          </div>
          <div class="api-desc">
            Every error shares one shape: <code>{ "success": false, "error": "message" }</code>.
            Messages come back in Indonesian; the common ones and their meaning:<br>
            <b>"URL atau ID YouTube tidak valid"</b> — invalid YouTube URL or ID<br>
            <b>"Parameter type harus auto, video, shorts, atau svfrom"</b> — type must be auto, video, shorts, or svfrom<br>
            <b>"Parameter dl atau itag tidak valid"</b> — dl or itag parameter is invalid<br>
            <b>"Format tidak tersedia di upstream"</b> — format unavailable upstream (itag expired / not offered in that region)<br>
            <b>"Domain tidak diizinkan"</b> — domain not allowed (for <code>?proxy=</code>)<br>
            <b>"SaveFrom error: ..."</b> — SaveFrom API failed (usually rate limit or unrecognized URL format)<br>
            <b>"Format tidak ditemukan di SaveFrom (mungkin expired)"</b> — no matching q/ext/ct combination in the SaveFrom response
          </div>
        </div>
      </div>

      <div class="api-card api-mail">
        <div class="api-head">
          <div class="api-ico"><i class="fa-solid fa-envelope-open-text"></i></div>
          <div class="api-title-box">
            <div class="api-title">mail.tm API</div>
            <div class="api-sub">// api.mail.tm — via Worker proxy</div>
          </div>
        </div>

        <div class="api-item">
          <div class="api-item-name">
            <span class="api-method get">GET</span> List Domains
          </div>
          <div class="api-url">https://api.mail.tm/domains</div>
          <div class="api-desc">Returns the list of active domains. The payload uses the <b>hydra:member</b> key.</div>
        </div>

        <div class="api-item">
          <div class="api-item-name">
            <span class="api-method post">POST</span> Create Account
          </div>
          <div class="api-url">https://api.mail.tm/accounts</div>
          <div class="api-desc">Body: <code>{ address, password }</code>. The password must be at least 8 characters.</div>
        </div>

        <div class="api-item">
          <div class="api-item-name">
            <span class="api-method post">POST</span> Get Token
          </div>
          <div class="api-url">https://api.mail.tm/token</div>
          <div class="api-desc">Body: <code>{ address, password }</code>. Returns <code>{ token, id }</code>.</div>
        </div>

        <div class="api-item">
          <div class="api-item-name">
            <span class="api-method get">GET</span> Get Messages
          </div>
          <div class="api-url">https://api.mail.tm/messages</div>
          <div class="api-desc">
            Header: <code>Authorization: Bearer {token}</code>. The list comes back under the <b>hydra:member</b> key.
          </div>
          <button class="api-code-toggle" data-target="code-mailtm-flow">
            <i class="fa-solid fa-chevron-right"></i> Full Flow Example
          </button>
          <pre class="api-code" id="code-mailtm-flow">const TM_WORKER = 'https://am-web.xyncteamofficial.workers.dev';
const TM_API    = 'https://api.mail.tm';

function tmProxy(target, extraHeaders) {
  const h = extraHeaders || {};
  const hb64 = btoa(unescape(encodeURIComponent(JSON.stringify(h))));
  return `${TM_WORKER}/?target=${encodeURIComponent(target)}&hdrs=${encodeURIComponent(hb64)}`;
}

const dRes = await fetch(tmProxy(`${TM_API}/domains`));
const dData = await dRes.json();
const domain = dData['hydra:member'][0].domain;

const address = `user${Date.now()}@${domain}`;
const password = 'MyPass123!@';

await fetch(tmProxy(`${TM_API}/accounts`), {
  method: 'POST',
  headers: { 'Content-Type': 'application/json' },
  body: JSON.stringify({ address, password })
});

const tRes = await fetch(tmProxy(`${TM_API}/token`), {
  method: 'POST',
  headers: { 'Content-Type': 'application/json' },
  body: JSON.stringify({ address, password })
});
const { token } = await tRes.json();

const mRes = await fetch(tmProxy(`${TM_API}/messages`, {
  'Authorization': `Bearer ${token}`
}));
const mData = await mRes.json();
console.log(mData['hydra:member']);</pre>
        </div>

        <div class="api-item">
          <div class="api-item-name">
            <span class="api-method get">GET</span> Read Message
          </div>
          <div class="api-url">https://api.mail.tm/messages/{id}</div>
          <div class="api-desc">
            Header: <code>Authorization: Bearer {token}</code>. The body is returned in <code>html[0]</code> or <code>text</code>.
          </div>
        </div>
      </div>

    </div>
  </div>

</div>

