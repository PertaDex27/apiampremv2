    <button class="nav-btn active" data-tab="am">
      <img class="nav-logo-img" src="image/am.png" alt="AM"
        onerror="this.replaceWith(Object.assign(document.createElement('i'),{className:'fa-solid fa-shield-halved'}))">
      <span>Am Prem</span>
    </button>
    <button class="nav-btn" data-tab="downloader">
      <i class="fa-solid fa-download"></i>
      <span>Downloader</span>
    </button>
