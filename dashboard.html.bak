        <div class="api-item">
          <div class="api-item-name">
            <span class="api-method get">GET</span> Auto Metadata (Video / Shorts)
          </div>
          <div class="api-url">/?url={YOUTUBE_URL_OR_ID}&type={auto|video|shorts}&region={REGION_CODE}</div>
          <div class="api-desc">
            Main endpoint to get title, author, duration, thumbnail and every available format.
            <b>type</b> is optional (default <b>auto</b> — video/shorts is detected automatically),
            <b>region</b> is optional to force a region (ID, US, GB, JP, SG, MY).
            Formats live in <b>data.videos[]</b>, <b>data.audios[]</b> and again merged in <b>data.medias[]</b>.
            Every item carries <b>itag</b>, <b>quality</b>, <b>extension</b>, <b>fileSize</b>, <b>size</b>,
            <b>width</b>, <b>height</b>, <b>fps</b>, <b>bitrate</b> and <b>hasAudio</b>.<br>
            <b>NEW in v2.2.1:</b> if all YouTube <b>client × region</b> combinations fail, the Worker automatically
            falls back to <b>SaveFrom</b>. Response shape stays the same, but <b>client</b> becomes <code>"SAVEFROM"</code>
            and <b>source</b> becomes <code>"savefrom-fallback"</code>.
          </div>
          <button class="api-code-toggle" data-target="code-yt-meta">
            <i class="fa-solid fa-chevron-right"></i> Example
          </button>
          <pre class="api-code" id="code-yt-meta">const YT_DL_API = 'https://api-ytdlv1.xyncteamofficial.workers.dev';

const auto = await fetch(`${YT_DL_API}?url=${encodeURIComponent('https://www.youtube.com/watch?v=dQw4w9WgXcQ')}`);
console.log(await auto.json());

const shorts = await fetch(
  `${YT_DL_API}?region=JP&type=shorts&url=${encodeURIComponent('https://www.youtube.com/shorts/dQw4w9WgXcQ')}`
);
console.log(await shorts.json());

await fetch(`${YT_DL_API}?url=dQw4w9WgXcQ`);</pre>
