        <div class="api-item">
          <div class="api-item-name">
            <span class="api-method get">GET</span> Download Stream by itag
          </div>
          <div class="api-url">/?dl={VIDEO_ID}&itag={ITAG}&q={LABEL}&ext={mp4|webm|m4a}</div>
          <div class="api-desc">
            The raw download link. The file is streamed straight through with the
            <b>Content-Disposition</b> header (automatic filename), <b>Content-Length</b>, <b>Content-Range</b>
            and <b>X-Copyright</b> — those headers are exposed through CORS.
            <b>Range requests</b> are supported (HTTP <b>206</b>), so download managers and resume work fine.
            The <b>q</b> parameter is only a label (used for the filename); the real quality is decided by <b>itag</b>.
          </div>
          <button class="api-code-toggle" data-target="code-yt-dl">
            <i class="fa-solid fa-chevron-right"></i> Example
          </button>
          <pre class="api-code" id="code-yt-dl">const YT_DL_API = 'https://api-ytdlv1.xyncteamofficial.workers.dev';

const meta  = await (await fetch(`${YT_DL_API}?url=dQw4w9WgXcQ`)).json();
const first = meta.data.videos.find(v => v.hasAudio);

const dlUrl = `${YT_DL_API}?dl=${meta.data.id}` +
  `&itag=${first.itag}` +
  `&q=${encodeURIComponent(first.quality)}` +
  `&ext=${first.extension}`;

const a = document.createElement('a');
a.href = dlUrl;
a.download = `${meta.data.title}.${first.extension}`;
a.click();

const res = await fetch(dlUrl);
const total = Number(res.headers.get('content-length')) || 0;
console.log('file size:', total, 'bytes');
const blob = await res.blob();</pre>
        </div>

        <div class="api-item">
          <div class="api-item-name">
            <span class="api-method get">GET</span> Media Proxy (CORS / expiry workaround)
          </div>
          <div class="api-url">/?proxy={URL_ENCODED}</div>
          <div class="api-desc">
            Use it to route raw media links (googlevideo.com and friends) so you avoid CORS and can track download progress.
            Allowed domains: <b>googlevideo.com</b> and <b>youtube.com</b>.
            Any other domain → <code>{"success":false,"error":"Domain tidak diizinkan"}</code> ("domain not allowed").
            Note: <b>i.ytimg.com is not allowlisted</b>, so thumbnails are still requested directly.
          </div>
          <button class="api-code-toggle" data-target="code-yt-proxy">
            <i class="fa-solid fa-chevron-right"></i> Example
          </button>
          <pre class="api-code" id="code-yt-proxy">const YT_DL_API = 'https://api-ytdlv1.xyncteamofficial.workers.dev';

function ytToProxy(rawUrl) {
  const host = new URL(rawUrl).hostname.toLowerCase();
  const allowed = host.endsWith('googlevideo.com') || host === 'youtube.com' || host.endsWith('.youtube.com');
  return allowed ? `${YT_DL_API}?proxy=${encodeURIComponent(rawUrl)}` : rawUrl;
}

const meta = await (await fetch(`${YT_DL_API}?url=dQw4w9WgXcQ`)).json();
const pick = meta.data.videos.find(v => v.hasAudio);

const res  = await fetch(ytToProxy(pick.url), { headers: { Range: 'bytes=0-' } });
const blob = await res.blob();</pre>
        </div>

        <!-- ====== SAVEFROM SECTION (NEW in v2.2.1) ====== -->

        <div class="api-item">
          <div class="api-item-name">
            <span class="api-method get">GET</span> SaveFrom Fallback (Automatic)
          </div>
          <div class="api-url">/?url={YOUTUBE_URL}</div>
          <div class="api-desc">
            When every YouTube <b>client × region</b> combination fails, the Worker automatically falls back to <b>SaveFrom</b>.
            The response shape stays identical (<b>data.videos[]</b> + <b>data.audios[]</b> + <b>data.medias[]</b>),
            so the frontend does not need a special branch.<br>
            Only these fields change:
            <br>• <b>client</b> → <code>"SAVEFROM"</code>
            <br>• <b>source</b> → <code>"savefrom-fallback"</code>
            <br>• <b>fallbackFrom</b> → <code>"youtube"</code>
            <br>• <b>yt_attempts</b> → log of every failed YouTube attempt
            <br>• <b>itag</b> becomes <code>sv1</code>, <code>sv2</code>, etc. (not numeric)
          </div>
        </div>

        <div class="api-item">
          <div class="api-item-name">
            <span class="api-method get">GET</span> Force SaveFrom (Direct)
          </div>
          <div class="api-url">/?type=svfrom&url={YOUTUBE_URL}</div>
          <div class="api-desc">
            Skip YouTube entirely and go straight to SaveFrom. Useful when YouTube is completely down
            or when you specifically want SaveFrom's format list (sometimes different resolutions / codecs than YouTube native).<br>
            Response: <b>client: "SAVEFROM"</b>, <b>source: "savefrom"</b> (no <code>-fallback</code> suffix).
          </div>
          <button class="api-code-toggle" data-target="code-yt-svfrom">
            <i class="fa-solid fa-chevron-right"></i> Example
          </button>
          <pre class="api-code" id="code-yt-svfrom">const YT_DL_API = 'https://api-ytdlv1.xyncteamofficial.workers.dev';

const forced = await fetch(
  `${YT_DL_API}?type=svfrom&url=${encodeURIComponent('https://www.youtube.com/watch?v=dQw4w9WgXcQ')}`
);
const data = await forced.json();
console.log(data.client);   // "SAVEFROM"
console.log(data.source);   // "savefrom"
console.log(data.data.videos);</pre>
        </div>

        <div class="api-item">
          <div class="api-item-name">
            <span class="api-method get">GET</span> SaveFrom Download Proxy
          </div>
          <div class="api-url">/?svdl=1&vid={VIDEO_ID}&q={QUALITY}&ext={ext}&ct={0|1}&yt={YOUTUBE_URL}</div>
          <div class="api-desc">
            Internal endpoint used when <b>source: savefrom</b>. The Worker re-calls the SaveFrom API
            (avoiding expired URLs), matches the format by <b>q</b> + <b>ext</b> + <b>ct</b>, and then
            proxies the file straight to the client.<br>
            <b>ct=1</b> → converter format (Video + Audio merged through <code>du.sf-converter.com</code>).<br>
            <b>ct=0</b> → direct googlevideo format (video-only or audio-only).<br>
            The frontend usually does not call this manually — every <b>url</b> in <b>data.videos[]</b> / <b>data.audios[]</b>
            already carries the query string for this endpoint.
          </div>
        </div>

        <div class="api-item">
          <div class="api-item-name">
            <span class="api-method get">GET</span> SaveFrom Response Format
          </div>
          <div class="api-desc">
            Response structure is identical to YouTube native so the frontend does not need a special branch.
            The only differences are <b>client: "SAVEFROM"</b>, <b>source: "savefrom"</b> / <b>"savefrom-fallback"</b>, and
            <b>itag</b> values of <code>sv1</code>, <code>sv2</code>, etc.
          </div>
