      <i class="fa-solid fa-envelope-open-text"></i>
      <span>Temp Mail</span>
    </button>
    <button class="nav-btn" data-tab="api">
      <i class="fa-solid fa-code"></i>
      <span>API List</span>
    </button>
  </div>
</div>

<div class="foot-wrap">
  <div class="copy-note">
    © 2026 <span class="brand-tag">XyncTeam</span> — All Rights Reserved<br>
  </div>
</div>

<div class="prof-sheet" id="profPanel">
  <div class="prof-inner">
    <button class="prof-x" id="panelClose"><i class="fa-solid fa-xmark"></i></button>
    <div class="prof-pic-wrap">
      <img class="prof-pic" id="profPhoto" src="" alt="" style="display:none;"
        onerror="this.style.display='none';this.nextElementSibling.style.display='flex';">
      <div class="prof-pic" id="profLetter" style="display:none;">?</div>
    </div>
    <div class="prof-head">
      <div class="prof-display" id="profName">-</div>
      <div class="prof-badge" id="profBadge"><i class="fa-solid fa-circle-check"></i> <span>Verified</span></div>
    </div>
    <div class="prof-rows">
      <div class="prof-row">
        <div class="f-ico"><i class="fa-solid fa-envelope"></i></div>
        <div class="f-body"><div class="f-label">Email</div><div class="f-value" id="profMail">-</div></div>
      </div>
      <div class="prof-row">
        <div class="f-ico"><i class="fa-solid fa-fingerprint"></i></div>
        <div class="f-body"><div class="f-label">User ID</div><div class="f-value" id="profUid">-</div></div>
        <button class="copy-btn" data-copy="profUid" title="Copy UID"><i class="fa-solid fa-copy"></i></button>
      </div>
      <div class="prof-row">
        <div class="f-ico"><i class="fa-solid fa-shield-halved"></i></div>
        <div class="f-body"><div class="f-label">Provider</div><div class="f-value" id="profProv">-</div></div>
      </div>
      <div class="prof-row">
        <div class="f-ico"><i class="fa-solid fa-calendar-plus"></i></div>
        <div class="f-body"><div class="f-label">Dibuat</div><div class="f-value" id="profCreated">-</div></div>
      </div>
      <div class="prof-row">
        <div class="f-ico"><i class="fa-solid fa-clock-rotate-left"></i></div>
        <div class="f-body"><div class="f-label">Login Terakhir</div><div class="f-value" id="profLastIn">-</div></div>
      </div>
    </div>
    <button class="prof-signout" id="btnSignout"><i class="fa-solid fa-right-from-bracket"></i> Logout Akun</button>
  </div>
</div>

