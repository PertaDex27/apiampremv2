      <div class="api-card api-tiktok">
        <div class="api-head">
          <div class="api-ico"><i class="fa-brands fa-tiktok"></i></div>
          <div class="api-title-box">
            <div class="api-title">TikTok API v2</div>
            <div class="api-sub">// api-tiktokv2.vercel.app — via Worker proxy</div>
          </div>
        </div>

        <div class="api-item">
          <div class="api-item-name">
            <span class="api-method get">GET</span> Fetch Video / Slide
          </div>
          <div class="api-url">https://am-web.xyncteamofficial.workers.dev/?target={ENCODED}</div>
          <div class="api-desc">
            Every request goes through the Worker proxy. Real target: <b>api-tiktokv2.vercel.app/api/v2/tiktok</b>.
            The <b>source</b> param is optional: <b>tikwm</b> (default), <b>snaptikapp</b>, <b>snaptikfi</b>.
            Response headers: <b>X-Source</b> = source actually used, <b>X-HD</b> = <b>direct</b> / <b>fallback</b>.
            Note: SnapTik.app does not return <b>likes</b> or <b>audio</b> data, so this site hides the Likes stat whenever the source is snaptikapp.
          </div>
          <button class="api-code-toggle open" data-target="code-tiktok-v2">
            <i class="fa-solid fa-chevron-right"></i> Example
          </button>
          <pre class="api-code show" id="code-tiktok-v2">const TT_WORKER = 'https://am-web.xyncteamofficial.workers.dev';
const TT_API    = 'https://api-tiktokv2.vercel.app/api/v2/tiktok';

const url = 'https://www.tiktok.com/@user/video/123456';

const target = `${TT_API}?url=${encodeURIComponent(url)}`;
const res = await fetch(`${TT_WORKER}/?target=${encodeURIComponent(target)}`);
console.log(res.headers.get('X-Source'), await res.json());

const hdTarget = `${TT_API}?source=snaptikapp&url=${encodeURIComponent(url)}`;
const hd = await fetch(`${TT_WORKER}/?target=${encodeURIComponent(hdTarget)}`);
console.log(hd.headers.get('X-HD'), await hd.json());

const postTarget = TT_API;
const post = await fetch(`${TT_WORKER}/?target=${encodeURIComponent(postTarget)}`, {
  method: 'POST',
  headers: { 'Content-Type': 'application/json' },
  body: JSON.stringify({ url, source: 'snaptikfi' })
});
console.log(await post.json());</pre>
        </div>

        <div class="api-item">
          <div class="api-item-name">
            <span class="api-method get">GET</span> Response Format
          </div>
          <div class="api-desc">
            Success → <b>code: 0</b>. Failure → <b>status: false</b> plus an <b>errors</b> object per source.
            The <b>message</b> value below is returned in Indonesian by the API ("Semua sumber gagal" = all sources failed).
          </div>
          <button class="api-code-toggle" data-target="code-tiktok-v2-res">
            <i class="fa-solid fa-chevron-right"></i> Example
          </button>
          <pre class="api-code" id="code-tiktok-v2-res">{
  "code": 0,
  "msg": "success",
  "data": {
    "id": "7687490640900394261",
    "title": "...",
    "cover": "https://...",
    "duration": 22,
    "play": "https://...",
    "hdplay": "https://...",
    "wmplay": "",
    "music": "https://...",
    "music_info": { "title": "...", "play": "https://..." },
    "play_count": 96700,
    "digg_count": 0,
    "comment_count": 123,
    "share_count": 763,
    "author": { "unique_id": "kri_s18", "nickname": "...", "avatar": "https://..." },
    "images": null
  },
  "copyright": "© XyncTeam 2026"
}

{
  "status": false,
  "message": "Semua sumber gagal",
  "errors": {
    "tikwm": "...",
    "snaptikapp": "Video not found or unavailable",
    "snaptikfi": "..."
  },
  "copyright": "© XyncTeam 2026"
}</pre>
        </div>

        <div class="api-item">
          <div class="api-item-name">
            <span class="api-method get">GET</span> Code used by this site
          </div>
          <div class="api-desc">
            Every TikTok request goes through the Worker proxy. Nothing is sent to Vercel directly.
          </div>
          <button class="api-code-toggle" data-target="code-tiktok-web">
            <i class="fa-solid fa-chevron-right"></i> Example
          </button>
          <pre class="api-code" id="code-tiktok-web">const TT_WORKER = 'https://am-web.xyncteamofficial.workers.dev';
const TT_API    = 'https://api-tiktokv2.vercel.app/api/v2/tiktok';

let ttSource = '';

document.querySelectorAll('.tt-src').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.tt-src').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    ttSource = btn.dataset.src;
  });
});

async function fetchTikTok(url) {
  const qs = new URLSearchParams({ url });
  if (ttSource) qs.set('source', ttSource);

  const target = `${TT_API}?${qs}`;
  const res = await fetch(`${TT_WORKER}/?target=${encodeURIComponent(target)}`, {
    headers: { 'Accept': 'application/json' }
  });

  const json = await res.json().catch(() => ({}));

  if (!res.ok) {
    const detail = json.errors
      ? Object.entries(json.errors).map(([k, v]) => `${k}: ${v}`).join(' | ')
      : '';
    throw new Error(json.message || detail || `HTTP ${res.status}`);
  }

  json._source = res.headers.get('X-Source') || ttSource || 'tikwm';
  json._hd = res.headers.get('X-HD') || '';
  return json;
}</pre>
        </div>

        <div class="api-item">
          <div class="api-item-name">
            <span class="api-method post">POST</span> TikWM (raw)
          </div>
          <div class="api-url">https://tikwm.com/api/</div>
          <div class="api-desc">
            The default upstream used by API v2. Body: <b>url</b>, <b>hd=1</b>.
          </div>
          <button class="api-code-toggle" data-target="code-tikwm">
            <i class="fa-solid fa-chevron-right"></i> Example
          </button>
          <pre class="api-code" id="code-tikwm">import axios from 'axios';
import qs from 'qs';

const data = qs.stringify({
  url: 'https://www.tiktok.com/@user/video/123456',
  hd: '1'
});

const response = await axios({
  method: 'POST',
  url: 'https://tikwm.com/api/',
  headers: {
    'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
    'Cookie': 'current_language=en',
    'User-Agent': 'Mozilla/5.0 (Linux; Android 10; K) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/116.0.0.0 Mobile Safari/537.36'
  },
  data: data,
  timeout: 30000
});

console.log(response.data);</pre>
        </div>
      </div>

      <div class="api-card api-spotify">
        <div class="api-head">
          <div class="api-ico"><i class="fa-brands fa-spotify"></i></div>
          <div class="api-title-box">
            <div class="api-title">Spotify API v2</div>
            <div class="api-sub">// api-tiktokv2.vercel.app — via Worker proxy</div>
          </div>
        </div>

        <div class="api-item">
          <div class="api-item-name">
            <span class="api-method get">GET</span> Search / Track / Album / Playlist
          </div>
          <div class="api-url">https://am-web.xyncteamofficial.workers.dev/?target={ENCODED}</div>
          <div class="api-desc">
            Real target: <b>api-tiktokv2.vercel.app/api/v2/spotify</b>.
            Returns <b>metadata only</b> by default. Add the <b>track</b> param to also get MP3 links:
            <code>1</code> / <code>1,3</code> / <code>all</code>.
          </div>
          <button class="api-code-toggle" data-target="code-sp-meta">
            <i class="fa-solid fa-chevron-right"></i> Example
          </button>
          <pre class="api-code" id="code-sp-meta">const SP_WORKER = 'https://am-web.xyncteamofficial.workers.dev';
const SP_API    = 'https://api-tiktokv2.vercel.app/api/v2/spotify';

const target = `${SP_API}?q=Snowfall`;
const res = await fetch(`${SP_WORKER}/?target=${encodeURIComponent(target)}`);
console.log(await res.json());

const targetTrack = `${SP_API}?url=${encodeURIComponent('https://open.spotify.com/track/xxx')}`;
const t = await fetch(`${SP_WORKER}/?target=${encodeURIComponent(targetTrack)}`);
console.log(await t.json());</pre>
        </div>

        <div class="api-item">
          <div class="api-item-name">
            <span class="api-method get">GET</span> Get MP3 Download Link
          </div>
          <div class="api-url">.../api/v2/spotify?url={URL}&amp;track=1,2</div>
          <div class="api-url">.../api/v2/spotify?q={KEYWORD}&amp;track=all&amp;limit=5</div>
          <div class="api-desc">
            <b>track</b> selects specific track numbers. <b>track=all</b> returns everything (max 100, capped by <b>limit</b>).<br>
            The response gives you <b>download</b> (a direct link) and <b>download_proxy</b> (streamed through this API's own domain).
          </div>
          <button class="api-code-toggle" data-target="code-sp-dl">
            <i class="fa-solid fa-chevron-right"></i> Example
          </button>
          <pre class="api-code" id="code-sp-dl">const target = `${SP_API}?url=${encodeURIComponent('https://open.spotify.com/album/xxx')}&track=1`;
const dl = await fetch(`${SP_WORKER}/?target=${encodeURIComponent(target)}`);
const data = await dl.json();
console.log(data.tracks[0].download);
console.log(data.tracks[0].download_proxy);

const stream = data.tracks[0].download_proxy;
const file = await fetch(stream);
console.log(file.headers.get('Content-Disposition'), file.headers.get('Content-Type'));</pre>
        </div>

        <div class="api-item">
          <div class="api-item-name">
            <span class="api-method get">GET</span> Full Parameter List
          </div>
          <div class="api-desc">
            <b>url</b> — Spotify link (track / album / playlist)<br>
            <b>q</b> — search keyword (alternative to url)<br>
            <b>track</b> — <code>1</code> / <code>1,3</code> / <code>all</code><br>
            <b>limit</b> — cap the number of tracks (number)<br>
            <b>meta</b> — <code>true</code> for metadata only<br>
            <b>dl</b> — streams the MP3 through this API's domain, feed it the <b>download</b> value from the response (+ <b>name</b> for the filename)<br>
            <b>token</b> — premium session_token (optional)<br>
            <b>license</b> — adfree licenseKey (optional)
          </div>
          <button class="api-code-toggle" data-target="code-sp-res">
