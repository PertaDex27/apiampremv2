          </div>
          <div class="api-url">/api/am?action=send&apikey={KEY}&email={EMAIL}</div>
          <div class="api-desc">
            Sends a magic link to the target email. The Worker proxy is required because of CORS.
            Parameters: <b>action</b>, <b>apikey</b>, <b>email</b>.
          </div>
          <button class="api-code-toggle" data-target="code-am-send">
            <i class="fa-solid fa-chevron-right"></i> Example
          </button>
          <pre class="api-code" id="code-am-send">const AM_PROXY = 'https://am-web.xyncteamofficial.workers.dev';
const AM_API   = 'https://restapidhan.vercel.app';
const AM_KEY   = 'freeapikeydhan26';

const target = `${AM_API}/api/am` +
  `?action=send` +
  `&apikey=${encodeURIComponent(AM_KEY)}` +
  `&email=${encodeURIComponent('user@example.com')}`;

const url = `${AM_PROXY}/?target=${encodeURIComponent(target)}`;

const res = await fetch(url, {
  method: 'GET',
  headers: { 'Accept': 'application/json' }
});
const data = await res.json();
console.log(data);</pre>
        </div>

